class Solution {
public:
    bool validateStackSequences(vector<int>& pushed, vector<int>& popped) {
        int top = 0;   
        int popIdx = 0;
        
        for (int x : pushed) {
            pushed[top++] = x; 
            
            while (top > 0 && pushed[top - 1] == popped[popIdx]) {
                top--;         
                popIdx++;
            }
        }
        
        return top == 0;
    }
};
