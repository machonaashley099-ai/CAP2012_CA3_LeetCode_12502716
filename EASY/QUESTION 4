class Solution {
public:
    void moveZeroes(vector<int>& nums) {
        int lastNonZeroPos = 0;
        
        for (int i = 0; i < nums.size(); i++) {
            if (nums[i] != 0) {
                swap(nums[lastNonZeroPos], nums[i]);
                lastNonZeroPos++;
            }
        }
    }
};
