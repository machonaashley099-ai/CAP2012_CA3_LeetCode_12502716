class Solution {
public:
    ListNode* middleNode(ListNode* head) {
        int length = 0;
        ListNode* curr = head;
        
       
        while (curr != nullptr) {
            length++;
            curr = curr->next;
        }
        
        
        curr = head;
        for (int i = 0; i < length / 2; i++) {
            curr = curr->next;
        }
        
        return curr;
    }
};
